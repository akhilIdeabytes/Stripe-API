# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# App
PORT=3000
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=changeme
DB_NAME=stripe_api

# Auth
JWT_SECRET=SecretKey
JWT_EXPIRES_IN=1d
JWT_EXPIRES_IN_SECONDS=86400
# Seeds one admin user on first boot if it doesn't already exist.
# Safe to leave set permanently — it only ever creates, never overwrites.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Publishable key - safe to send to browsers, used by the UI to render
# the embedded Stripe payment form. Find it next to your secret key.
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Comma-separated list of browser origins allowed to call this API.
# The console plus any portal that talks to it from a browser.
CORS_ORIGINS=http://localhost:5173

# Where uploaded invoice files are written.
UPLOAD_DIR=./uploads
